+/*
+ *----------------------------------------------------------------------
+ *
+ * DrawChrome --
+ *
+ *	Draws every part of the graph EXCEPT the dynamic overlay (the
+ *	elements, above-markers, active elements and a raised in-plot
+ *	legend).  This is the static "chrome": plot background, grid,
+ *	under-markers, under-legend, axis limits, margins (axes + tick
+ *	labels), 3D border and focus ring.  Used by the -bufferchrome
+ *	optimization so the chrome can be rendered once into a cache pixmap
+ *	and reused across frames.  The drawing order mirrors Blt_DrawGraph
+ *	with the dynamic overlay omitted, so compositing the overlay on top
+ *	is pixel-identical to a full redraw.
+ *
+ *----------------------------------------------------------------------
+ */
+static void
+DrawChrome(graphPtr, drawable)
+    Graph *graphPtr;
+    Drawable drawable;
+{
+    /* Plot background + grid + under-markers + under-legend + axis limits. */
+    XFillRectangle(graphPtr->display, drawable, graphPtr->plotFillGC,
+	graphPtr->left, graphPtr->top, graphPtr->right - graphPtr->left + 1,
+	graphPtr->bottom - graphPtr->top + 1);
+    if (!graphPtr->gridPtr->hidden) {
+	Blt_DrawGrid(graphPtr, drawable);
+    }
+    Blt_DrawMarkers(graphPtr, drawable, MARKER_UNDER);
+    if ((Blt_LegendSite(graphPtr->legend) & LEGEND_IN_PLOT) &&
+	(!Blt_LegendIsRaised(graphPtr->legend))) {
+	Blt_DrawLegend(graphPtr->legend, drawable);
+    }
+    Blt_DrawAxisLimits(graphPtr, drawable);
+
+    /* Margins (axes + tick labels). */
+    if (graphPtr->flags & DRAW_MARGINS) {
+	DrawMargins(graphPtr, drawable);
+    }
+    /* 3D border just inside the focus highlight ring. */
+    if ((graphPtr->borderWidth > 0) && (graphPtr->relief != TK_RELIEF_FLAT)) {
+	Blt_Draw3DRectangle(graphPtr->tkwin, drawable, graphPtr->border,
+	    graphPtr->highlightWidth, graphPtr->highlightWidth,
+	    graphPtr->width - 2 * graphPtr->highlightWidth,
+	    graphPtr->height - 2 * graphPtr->highlightWidth,
+	    graphPtr->borderWidth, graphPtr->relief);
+    }
+    /* Focus highlight ring. */
+    if ((graphPtr->highlightWidth > 0) && (graphPtr->flags & GRAPH_FOCUS)) {
+	GC gc;
+
+	gc = Tk_GCForColor(graphPtr->highlightColor, drawable);
+	Tk_DrawFocusHighlight(graphPtr->tkwin, gc, graphPtr->highlightWidth,
+	    drawable);
+    }
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
+ * DrawCachedChrome --
+ *
+ *	The -bufferchrome fast path.  Renders the static chrome into a
+ *	cache pixmap (only when its signature changes), copies it onto the
+ *	target drawable, and then draws the dynamic overlay (elements,
+ *	above-markers, active elements, raised in-plot legend) on top.
+ *
+ *----------------------------------------------------------------------
+ */
+static void
+DrawCachedChrome(graphPtr, drawable)
+    Graph *graphPtr;
+    Drawable drawable;
+{
+    unsigned long sig;
+
+    if ((graphPtr->chromePixmap == None) ||
+	(graphPtr->chromeWidth != graphPtr->width) ||
+	(graphPtr->chromeHeight != graphPtr->height)) {
+	if (graphPtr->chromePixmap != None) {
+	    Tk_FreePixmap(graphPtr->display, graphPtr->chromePixmap);
+	}
+	graphPtr->chromePixmap = Tk_GetPixmap(graphPtr->display,
+	    Tk_WindowId(graphPtr->tkwin), graphPtr->width, graphPtr->height,
+	    Tk_Depth(graphPtr->tkwin));
+	graphPtr->chromeWidth = graphPtr->width;
+	graphPtr->chromeHeight = graphPtr->height;
+	graphPtr->chromeValid = 0;
+    }
+    sig = Blt_ComputeChromeSignature(graphPtr);
+    if ((!graphPtr->chromeValid) || (sig != graphPtr->chromeSig)) {
+	DrawChrome(graphPtr, graphPtr->chromePixmap);
+	graphPtr->chromeSig = sig;
+	graphPtr->chromeValid = 1;
+    }
+    /* Composite cached chrome + dynamic overlay onto the drawable. */
+    XCopyArea(graphPtr->display, graphPtr->chromePixmap, drawable,
+	graphPtr->drawGC, 0, 0, graphPtr->width, graphPtr->height, 0, 0);
+    Blt_DrawElements(graphPtr, drawable);
+    Blt_DrawMarkers(graphPtr, drawable, MARKER_ABOVE);
+    Blt_DrawActiveElements(graphPtr, drawable);
+    if ((Blt_LegendSite(graphPtr->legend) & LEGEND_IN_PLOT) &&
+	(Blt_LegendIsRaised(graphPtr->legend))) {
+	Blt_DrawLegend(graphPtr->legend, drawable);
+    }
+}
