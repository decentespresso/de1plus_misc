+/*
+ * Blt_ComputeChromeSignature --
+ *
+ *	Computes a cheap hash that changes whenever any pixel of the
+ *	graph's "chrome" (background, grid, axes, tick labels, margins,
+ *	border) could change.  Used by the -bufferchrome optimization to
+ *	skip re-rendering the static chrome between frames when only the
+ *	element data has changed.  The signature folds in the graph
+ *	extents/plot rectangle, the focus state, and every axis's actual
+ *	range (min/max) and tick count -- which together determine the
+ *	rendered chrome.  Under "tight" auto-scaling the axis min/max move
+ *	every frame, so the signature changes and the chrome is correctly
+ *	redrawn; for fixed (-min/-max) axes it stays constant and the
+ *	cached chrome is reused.
+ */
+unsigned long
+Blt_ComputeChromeSignature(graphPtr)
+    Graph *graphPtr;
+{
+    Blt_HashEntry *hPtr;
+    Blt_HashSearch cursor;
+    Axis *axisPtr;
+    unsigned long sig = 1469598103UL;	/* FNV-ish basis */
+    int i;
+
+#define FOLD_INT(v) (sig = (sig ^ (unsigned long)(v)) * 16777619UL)
+#define FOLD_DBL(d) do { \
+	union { double dd; unsigned char b[sizeof(double)]; } u_; \
+	unsigned j_; u_.dd = (d); \
+	for (j_ = 0; j_ < sizeof(double); j_++) FOLD_INT(u_.b[j_]); \
+    } while (0)
+
+    FOLD_INT(graphPtr->width);
+    FOLD_INT(graphPtr->height);
+    FOLD_INT(graphPtr->left);
+    FOLD_INT(graphPtr->right);
+    FOLD_INT(graphPtr->top);
+    FOLD_INT(graphPtr->bottom);
+    FOLD_INT((graphPtr->flags & GRAPH_FOCUS) ? 1 : 0);
+    for (hPtr = Blt_FirstHashEntry(&graphPtr->axes.table, &cursor);
+	hPtr != NULL; hPtr = Blt_NextHashEntry(&cursor)) {
+	axisPtr = (Axis *)Blt_GetHashValue(hPtr);
+	FOLD_INT(axisPtr->hidden);
+	FOLD_DBL(axisPtr->min);
+	FOLD_DBL(axisPtr->max);
+	i = (axisPtr->t1Ptr != NULL) ? axisPtr->t1Ptr->nTicks : 0;
+	FOLD_INT(i);
+	i = (axisPtr->t2Ptr != NULL) ? axisPtr->t2Ptr->nTicks : 0;
+	FOLD_INT(i);
+    }
+#undef FOLD_INT
+#undef FOLD_DBL
+    return sig;
+}
