+/*
+ * -----------------------------------------------------------------
+ *
+ * Axis tick-label sprite cache (the graph's -cachelabels optimization).
+ *
+ *	Re-rasterizing tick-label text (FreeType/AGG) every redraw dominates
+ *	the cost of live charts whose axes move every frame (e.g. an
+ *	auto-scaling x axis), where the static-chrome cache can't help.  The
+ *	label strings repeat and only change position, and they sit in the
+ *	axis margin -- solid graph background, no grid underneath -- so each
+ *	label is rendered once onto a small background-filled pixmap and then
+ *	simply blitted at the new position.  Pixel-identical to drawing the
+ *	text directly, because the sprite's background is filled with the very
+ *	GC that paints the margins (graphPtr->fillGC).
+ * -----------------------------------------------------------------
+ */
+typedef struct {
+    Pixmap pixmap;		/* "<bg> + text" sprite. */
+    short width, height;	/* Sprite size (text + 2*pad). */
+    short textW, textH;		/* Text footprint, for anchor translation. */
+    short pad;			/* Background slack around the text. */
+} CachedLabel;
+
+static void
+FreeLabelCache(graphPtr, axisPtr)
+    Graph *graphPtr;
+    Axis *axisPtr;
+{
+    Blt_HashEntry *hPtr;
+    Blt_HashSearch cursor;
+    CachedLabel *clPtr;
+
+    if (!axisPtr->labelCacheReady) {
+	return;
+    }
+    for (hPtr = Blt_FirstHashEntry(&axisPtr->labelCache, &cursor);
+	hPtr != NULL; hPtr = Blt_NextHashEntry(&cursor)) {
+	clPtr = (CachedLabel *)Blt_GetHashValue(hPtr);
+	if (clPtr->pixmap != None) {
+	    Tk_FreePixmap(graphPtr->display, clPtr->pixmap);
+	}
+	Blt_Free(clPtr);
+    }
+    Blt_DeleteHashTable(&axisPtr->labelCache);
+    axisPtr->labelCacheReady = 0;
+}
+
+void
+Blt_ClearAllLabelCaches(graphPtr)
+    Graph *graphPtr;
+{
+    Blt_HashEntry *hPtr;
+    Blt_HashSearch cursor;
+    Axis *axisPtr;
+
+    for (hPtr = Blt_FirstHashEntry(&graphPtr->axes.table, &cursor);
+	hPtr != NULL; hPtr = Blt_NextHashEntry(&cursor)) {
+	axisPtr = (Axis *)Blt_GetHashValue(hPtr);
+	FreeLabelCache(graphPtr, axisPtr);
+    }
+}
+
+/* Fetch (or render-and-cache) the sprite for a tick label.  Returns NULL for
+ * the cases the cache doesn't handle (rotated/active/shadowed text) so the
+ * caller falls back to Blt_DrawText. */
+static CachedLabel *
+GetLabelSprite(graphPtr, axisPtr, string)
+    Graph *graphPtr;
+    Axis *axisPtr;
+    CONST char *string;
+{
+    Blt_HashEntry *hPtr;
+    int isNew, tw, th, pad;
+    CachedLabel *clPtr;
+    TextStyle *tsPtr = &axisPtr->tickTextStyle;
+    Tk_Anchor savedAnchor;
+
+    if ((tsPtr->theta != 0.0) || (tsPtr->shadow.offset > 0) ||
+	(tsPtr->state & (STATE_ACTIVE | STATE_DISABLED | STATE_EMPHASIS))) {
+	return NULL;		/* Not a simple horizontal label. */
+    }
+    if (!axisPtr->labelCacheReady) {
+	Blt_InitHashTable(&axisPtr->labelCache, BLT_STRING_KEYS);
+	axisPtr->labelCacheReady = 1;
+    }
+    hPtr = Blt_CreateHashEntry(&axisPtr->labelCache, (char *)string, &isNew);
+    if (!isNew) {
+	return (CachedLabel *)Blt_GetHashValue(hPtr);
+    }
+    tw = th = 0;
+    Blt_GetTextExtents(tsPtr, (char *)string, &tw, &th);
+    if ((tw <= 0) || (th <= 0)) {
+	Blt_DeleteHashEntry(&axisPtr->labelCache, hPtr);
+	return NULL;
+    }
+    pad = 2;
+    clPtr = Blt_Malloc(sizeof(CachedLabel));
+    clPtr->textW = tw;
+    clPtr->textH = th;
+    clPtr->pad = pad;
+    clPtr->width = tw + 2 * pad;
+    clPtr->height = th + 2 * pad;
+    clPtr->pixmap = Tk_GetPixmap(graphPtr->display,
+	Tk_WindowId(graphPtr->tkwin), clPtr->width, clPtr->height,
+	Tk_Depth(graphPtr->tkwin));
+    /* Background == the margin fill, so the blit is pixel-identical. */
+    XFillRectangle(graphPtr->display, clPtr->pixmap, graphPtr->fillGC,
+	0, 0, clPtr->width, clPtr->height);
+    savedAnchor = tsPtr->anchor;
+    tsPtr->anchor = TK_ANCHOR_NW;
+    Blt_DrawText(graphPtr->tkwin, clPtr->pixmap, (char *)string, tsPtr,
+	pad, pad);
+    tsPtr->anchor = savedAnchor;
+    Blt_SetHashValue(hPtr, clPtr);
+    return clPtr;
+}
