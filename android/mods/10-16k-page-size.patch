--- a/jni/Application64.mk
+++ b/jni/Application64.mk
@@ -14,3 +14,10 @@
 
 APP_ABI := arm64-v8a
 APP_ALLOW_MISSING_DEPS := true
+
+# 16 KB page-size support (Android 15+ devices with 16 KB pages, Google Play
+# requirement): links every .so/executable with -Wl,-z,max-page-size=16384
+# (LOAD segments 16 KB-aligned) and defines __BIONIC_NO_PAGE_SIZE_MACRO.
+# Without it a 16 KB kernel fails dlopen("libSDL2.so") with
+# "empty/missing DT_HASH/DT_GNU_HASH" and AndroWish.nativeInit is unresolved.
+APP_SUPPORT_FLEXIBLE_PAGE_SIZES := true
