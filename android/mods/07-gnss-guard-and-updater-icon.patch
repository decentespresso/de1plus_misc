+/*
+ * DecentUpdater -- second launcher icon for the Decent APK.
+ *
+ * de1plus/appupdate.tcl is a standalone, deliberately lean updater: it can
+ * re-download the app when the main app is too broken to start. That is only
+ * useful if the user can actually START it, so this activity gives it its own
+ * icon in the app drawer, next to Decent itself.
+ *
+ * It runs appupdate.tcl the same way any Tcl script is run on AndroWish: hand
+ * AndroWishLauncher an "arg" extra with the script path, and it dispatches to a
+ * free AndroWishScriptN process.
+ *
+ * The script lives in the WRITABLE copy of the bundle, which
+ * ::de1_redirect_data_root (google_play_store.tcl) creates on first run at
+ * $HOME/Documents/Decent, where AndroWish's HOME is the app's internal storage
+ * (SDL_AndroidGetInternalStoragePath = getFilesDir()). Before that first run
+ * there is nothing to launch, so we say so rather than starting a broken
+ * interpreter.
+ */
+package tk.tcl.wish;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.util.Log;
+import android.widget.Toast;
+
+import java.io.File;
+
+public class DecentUpdater extends Activity {
+
+    private static final String TAG = "DecentUpdater";
+
+    /* Candidate locations of the updater script, most likely first. */
+    private static final String[] CANDIDATES = {
+	"Documents/Decent/appupdate.tcl",
+	"Documents/Decent/de1plus/appupdate.tcl",
+	"Documents/de1app/appupdate.tcl",
+    };
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+	super.onCreate(savedInstanceState);
+
+	String script = null;
+	for (String candidate : CANDIDATES) {
+	    File f = new File(getFilesDir(), candidate);
+	    if (f.exists()) {
+		script = f.getAbsolutePath();
+		break;
+	    }
+	}
+
+	if (script == null) {
+	    Log.v(TAG, "*** no appupdate.tcl found under " + getFilesDir());
+	    Toast.makeText(this,
+		"Start Decent once first, then the updater is available.",
+		Toast.LENGTH_LONG).show();
+	    finish();
+	    return;
+	}
+
+	Log.v(TAG, "*** launching " + script);
+	Intent intent = new Intent(Intent.ACTION_VIEW, null, this,
+				   tk.tcl.wish.AndroWishLauncher.class);
+	intent.putExtra("arg", script);
+	startActivity(intent);
+	finish();
+    }
+}
